# =============================================================================
# DoisB Sistemas — Environment Variables
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Preços ZWeb (revenda Zucchetti)
STRIPE_PRICE_ESSENCIAL=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...

# Preços DoisB Web (carro-chefe — white-label Nuts). Anual = 10% off. Trial 5 dias aplicado no checkout.
STRIPE_PRICE_DOISB_ESSENCIAL_MENSAL=price_...
STRIPE_PRICE_DOISB_ESSENCIAL_ANUAL=price_...
STRIPE_PRICE_DOISB_STANDARD_MENSAL=price_...
STRIPE_PRICE_DOISB_STANDARD_ANUAL=price_...

# Preço GWeb (mini-mercados — white-label Gdoor)
STRIPE_PRICE_GWEB_MENSAL=price_...

# --- Resend (e-mails transacionais) ---
RESEND_API_KEY=re_...

# --- Anthropic Claude (chat IA / suporte) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (embeddings via pgvector) ---
OPENAI_API_KEY=sk-...

# --- Google Places (validação de endereço de clientes) ---
GOOGLE_PLACES_API_KEY=AIza...

# --- URL pública do site ---
NEXT_PUBLIC_SITE_URL=https://doisbsistemas.com.br

# --- Meta / Facebook Pixel + Conversions API ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1234567890123456
FACEBOOK_CONVERSIONS_API_TOKEN=EAA...        # System User token (Events Manager → Configurações → Conversions API)
# META_CAPI_TEST_EVENT_CODE=TEST12345         # opcional, só para testar no Events Manager
